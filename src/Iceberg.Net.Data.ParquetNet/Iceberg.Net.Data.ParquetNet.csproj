<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Iceberg.Net.Data.ParquetNet</RootNamespace>
    <Description>Parquet.Net (managed, no native binaries) as the Parquet library of Iceberg.Net.Data.</Description>
    <!-- Not packed until the Parquet.Net fork it builds on (external/parquet-dotnet) is published. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
    <ProjectReference Include="../../external/parquet-dotnet/src/Parquet/Parquet.csproj" />
  </ItemGroup>
</Project>
