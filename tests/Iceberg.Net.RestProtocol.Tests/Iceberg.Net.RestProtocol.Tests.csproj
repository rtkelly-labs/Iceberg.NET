<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Iceberg.Net.RestProtocol.Tests</RootNamespace>
    <Description>The REST catalog protocol, operation by operation: every OpenAPI operation's success and documented error responses against this repository's server, the client's mapping of each status, and the client contract against the emulated REST servers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Iceberg.Net.RestServer/Iceberg.Net.RestServer.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
    <ProjectReference Include="../Iceberg.Net.TestSupport/Iceberg.Net.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The in-process server host is shared with the server's own tests rather than copied. -->
    <Compile Include="../Iceberg.Net.RestServer.Tests/ServerHost.cs" Link="ServerHost.cs" />
    <Using Include="Xunit" />
    <Using Include="Iceberg.Net.TestSupport" />
  </ItemGroup>
</Project>
