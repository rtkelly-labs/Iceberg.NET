    <ProjectReference Include="../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Spark/Iceberg.Net.Spark.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Athena/Iceberg.Net.Athena.csproj" />
    <ProjectReference Include="../Iceberg.Net.TestSupport/Iceberg.Net.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
