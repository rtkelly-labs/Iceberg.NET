<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Iceberg.Net.Regression.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AWSSDK.Athena" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Parquet.SourceGenerator" />
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Arrow/Iceberg.Net.Arrow.csproj" />
    <!-- The EMR Serverless / Glue job runners and the Athena runner, driven against moto (and the job emulator). -->
    <ProjectReference Include="../../src/Iceberg.Net.Spark/Iceberg.Net.Spark.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Athena/Iceberg.Net.Athena.csproj" />
    <ProjectReference Include="../Iceberg.Net.TestSupport/Iceberg.Net.TestSupport.csproj" />
    <!-- The "dotnet-rest" catalog kind: this repository's REST catalog server, hosted by the suite (DotnetRestServer.cs). -->
    <ProjectReference Include="../../src/Iceberg.Net.RestServer/Iceberg.Net.RestServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
